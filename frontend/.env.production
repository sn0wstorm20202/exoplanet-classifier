# Production Environment Variables
# This file is used when building for production deployment on Vercel
# Replace YOUR_RENDER_BACKEND_URL with your actual Render backend URL
VITE_API_BASE_URL=https://YOUR_RENDER_BACKEND_URL.onrender.com
VITE_APP_ENV=production

# Production-specific variables
VITE_APP_NAME=Exoplanet Classifier
VITE_APP_VERSION=1.0.0

# Optional: Performance and analytics settings for production
# VITE_ANALYTICS_ID=your_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn